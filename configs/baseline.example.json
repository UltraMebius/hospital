{
  "experiment_name": "mineru-3.1-baseline",
  "parser": {
    "backend": "vlm",
    "command": ["mineru", "-p", "{input}", "-o", "{output}", "-b", "{backend}"],
    "timeout_seconds": 1800
  },
  "chunking": {
    "max_characters": 1200,
    "overlap_characters": 120,
    "preserve_tables": true,
    "include_heading_path": true
  },
  "evaluation": {
    "retrieval_k": [1, 3, 5, 10],
    "answer_metrics": ["exact_match", "token_f1"]
  }
}

